rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isOwner() {
      return signedIn() && request.auth.token.email == "t.nuha0500@gmail.com";
    }
    function isTeacher() {
      return signedIn() && me().data.role == "teacher";
    }
    function isStudent() {
      return signedIn() && me().data.role == "student";
    }

    match /joinCodes/{code} {
      // A student can verify one exact class code before signing in.
      // Listing all codes is blocked.
      allow get: if true;
      allow list: if false;
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.teacherId == request.auth.uid;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isOwner() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if isOwner();
    }

    match /classes/{classId} {
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      allow read: if signedIn() && (
        isOwner() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        (isStudent() && me().data.classId == classId)
      );
      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid;
      allow delete: if isOwner() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /attempts/{attemptId} {
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId == me().data.teacherId
        && request.resource.data.classId == me().data.classId;

      allow read: if signedIn() && (
        isOwner() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );

      allow update, delete: if false;
    }
  }
}
