rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isOwner() {
      return signedIn() && request.auth.token.email == "t.nuha0500@gmail.com";
    }
    function isTeacher() {
      return signedIn() && me().data.role == "teacher" && me().data.get("status", "active") == "active";
    }
    function isStudent() {
      return signedIn() && me().data.role == "student";
    }
    function ownsTeacherData() {
      return isTeacher() && resource.data.teacherId == request.auth.uid;
    }
    function createsOwnTeacherData() {
      return isTeacher() && request.resource.data.teacherId == request.auth.uid;
    }
    function ownsStudentData() {
      return isStudent() && resource.data.studentId == request.auth.uid;
    }
    function createsOwnStudentData() {
      return isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId == me().data.teacherId
        && request.resource.data.classId == me().data.classId;
    }

    match /joinCodes/{code} {
      allow get: if true;
      allow list: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    // Username aliases resolve only synthetic Auth identifiers. Rules must
    // be deployed separately to Firebase before rename-by-name is available.
    match /loginAliases/{aliasId} {
      allow get: if true;
      allow list: if false;
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(["uid", "classCode", "loginName", "loginEmail", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.classCode == me().data.classCode
        && request.resource.data.loginName is string
        && request.resource.data.loginName.size() >= 2
        && request.resource.data.loginName.size() <= 80
        && request.resource.data.loginEmail == request.auth.token.email
        && request.resource.data.loginEmail.matches('^s_[a-f0-9]{24}@students[.]proveit[.]local$')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          == request.resource.data.loginName;
      allow update: if false;
      allow delete: if isOwner();
    }

    match /users/{uid} {
      // Registration is closed: only the owner can provision administrative profiles.
      // Existing student documents remain readable/updatable under their original rules.
      allow create: if isOwner() && request.resource.data.role in ["owner", "teacher"];
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isOwner() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow update: if signedIn() && (
        isOwner() ||
        (
          request.auth.uid == uid &&
          resource.data.role == "student" &&
          request.resource.data.role == "student" &&
          request.resource.data.teacherId == resource.data.teacherId &&
          request.resource.data.classId == resource.data.classId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "pin"]) &&
          request.resource.data.get("pin", "0000").matches("^[0-9]{4}$")
        ) ||
        (
          request.auth.uid == uid &&
          resource.data.role == "teacher" &&
          request.resource.data.role == "teacher" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "school"])
        ) ||
        (
          isTeacher() &&
          resource.data.role == "student" &&
          resource.data.teacherId == request.auth.uid &&
          request.resource.data.teacherId == request.auth.uid &&
          request.resource.data.role == "student" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["classId"])
        )
      );
      allow delete: if isOwner() || (
        isTeacher() &&
        resource.data.role == "student" &&
        resource.data.teacherId == request.auth.uid
      );
    }

    match /classes/{classId} {
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow read: if signedIn() && (
        isOwner() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        (isStudent() && me().data.classId == classId)
      );
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow delete: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /archivedClasses/{classId} {
      allow read: if isOwner() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        (isStudent() && me().data.classId == classId);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /savedWords/{wordId} {
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId == me().data.teacherId
        && request.resource.data.classId == me().data.classId;

      allow read: if signedIn() && (
        isOwner() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );

      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.classId == resource.data.classId;

      allow delete: if isOwner() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /attempts/{attemptId} {
      allow create: if createsOwnStudentData();
      allow read: if signedIn() && (
        isOwner() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["classId"]);
      allow delete: if isOwner() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /assistantMessages/{messageId} {
      allow create: if createsOwnStudentData();
      allow read: if signedIn() && (
        isOwner() || ownsStudentData() || ownsTeacherData()
      );
      allow update: if false;
      allow delete: if isOwner() || ownsStudentData() || ownsTeacherData();
    }

    match /writingHistory/{historyId} {
      allow create: if createsOwnStudentData();
      allow read: if signedIn() && (
        isOwner() || ownsStudentData() || ownsTeacherData()
      );
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId == me().data.teacherId
        && request.resource.data.classId == me().data.classId;
      allow delete: if isOwner() || ownsStudentData() || ownsTeacherData();
    }

    match /assignments/{assignmentId} {
      allow create: if createsOwnTeacherData();
      allow read: if signedIn() && (
        isOwner() ||
        ownsTeacherData() ||
        (isStudent() && resource.data.classId == me().data.classId)
      );
      allow update: if isOwner() || (
        isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
      );
      allow delete: if isOwner() || ownsTeacherData();
    }

    match /assignmentSubmissions/{submissionId} {
      allow create: if createsOwnStudentData();
      allow read: if signedIn() && (
        isOwner() || ownsStudentData() || ownsTeacherData()
      );
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId == me().data.teacherId
        && request.resource.data.classId == me().data.classId;
      allow delete: if isOwner() || ownsStudentData() || ownsTeacherData();
    }

    match /studentGoals/{goalId} {
      allow create: if createsOwnStudentData();
      allow read: if signedIn() && (
        isOwner() || ownsStudentData() || ownsTeacherData()
      );
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId == me().data.teacherId
        && request.resource.data.classId == me().data.classId;
      allow delete: if isOwner() || ownsStudentData();
    }

    match /teacherNotes/{noteId} {
      allow create: if createsOwnTeacherData();
      allow read: if isOwner() || ownsTeacherData();
      allow update: if isOwner() || (
        isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
      );
      allow delete: if isOwner() || ownsTeacherData();
    }


    // Games Arcade: private, link-based student competitions.
    // A link opens one game for invited logged-in students. No official mastery is changed.
    function gameRoomOpen(roomId) {
      return exists(/databases/$(database)/documents/gameChallenges/$(roomId))
        && get(/databases/$(database)/documents/gameChallenges/$(roomId)).data.expiresAt > request.time;
    }
    function gameRoomMember(roomId) {
      return isStudent() && gameRoomOpen(roomId)
        && exists(/databases/$(database)/documents/gameChallenges/$(roomId)/players/$(request.auth.uid));
    }

    match /gameChallenges/{roomId} {
      allow get: if isStudent() && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if isStudent()
        && roomId.matches('^[A-Za-z0-9_-]{20,48}
      allow get: if true;
      allow list: if isOwner() || ownsTeacherData();
      allow create: if createsOwnTeacherData();
      allow update: if isOwner() || (
        isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
      );
      allow delete: if isOwner() || ownsTeacherData();
    }
  }
}
)
        && request.resource.data.keys().hasOnly(['gameId','createdBy','createdAt','expiresAt','schema'])
        && request.resource.data.keys().hasAll(['gameId','createdBy','createdAt','expiresAt','schema'])
        && request.resource.data.gameId == 'grammar-rescue'
        && request.resource.data.schema == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7,'d');
      allow update, delete: if false;

      match /players/{playerId} {
        allow get: if isStudent() && gameRoomOpen(roomId) && (playerId == request.auth.uid || gameRoomMember(roomId));
        allow list: if gameRoomMember(roomId);
        allow create: if isStudent() && gameRoomOpen(roomId)
          && playerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','name','joinedAt'])
          && request.resource.data.keys().hasAll(['uid','name','joinedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40
          && request.resource.data.joinedAt == request.time;
        allow update, delete: if false;
      }

      match /scores/{scoreId} {
        allow get, list: if gameRoomMember(roomId);
        allow create: if gameRoomMember(roomId)
          && request.resource.data.keys().hasOnly(['uid','roundKey','questions','mistakes','seconds','points','createdAt'])
          && request.resource.data.keys().hasAll(['uid','roundKey','questions','mistakes','seconds','points','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.roundKey in ['1','2','3','4']
          && scoreId == request.auth.uid + '_' + request.resource.data.roundKey
          && request.resource.data.questions is int
          && request.resource.data.questions ==
            (request.resource.data.roundKey == '3' ? 7 :
             request.resource.data.roundKey == '4' ? 3 : 4)
          && request.resource.data.mistakes is int
          && request.resource.data.mistakes >= 0
          && request.resource.data.mistakes <= request.resource.data.questions * 5
          && request.resource.data.points is int
          && request.resource.data.points == request.resource.data.questions * 10
             - request.resource.data.mistakes * 2
          && request.resource.data.seconds is int
          && request.resource.data.seconds >= 1
          && request.resource.data.seconds <= 7200
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /parentViews/{accessCode} {
      allow get: if true;
      allow list: if isOwner() || ownsTeacherData();
      allow create: if createsOwnTeacherData();
      allow update: if isOwner() || (
        isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
      );
      allow delete: if isOwner() || ownsTeacherData();
    }
  }
}
