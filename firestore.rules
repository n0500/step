rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isOwner() {
      return signedIn() && request.auth.token.email == "t.nuha0500@gmail.com";
    }
    function isTeacher() {
      return signedIn() && me().data.role == "teacher";
    }
    function isStudent() {
      return signedIn() && me().data.role == "student";
    }

    match /joinCodes/{code} {
      // Students may verify one exact class code before signing in.
      allow get: if true;

      // A teacher may list only their own codes. This is used to archive,
      // restore, move, or fully delete a class without exposing other codes.
      allow list: if isTeacher()
        && resource.data.teacherId == request.auth.uid;

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;

      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid;

      allow delete: if isTeacher()
        && resource.data.teacherId == request.auth.uid;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;

      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isOwner() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );

      allow update: if signedIn() && (
        request.auth.uid == uid ||
        (
          isTeacher() &&
          resource.data.role == "student" &&
          resource.data.teacherId == request.auth.uid &&
          request.resource.data.teacherId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["classId"])
        )
      );

      allow delete: if isOwner() || (
        isTeacher() &&
        resource.data.role == "student" &&
        resource.data.teacherId == request.auth.uid
      );
    }

    match /classes/{classId} {
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;

      allow read: if signedIn() && (
        isOwner() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        (isStudent() && me().data.classId == classId)
      );

      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid;

      allow delete: if isOwner() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /archivedClasses/{classId} {
      allow read: if isOwner() || (
        isTeacher() && resource.data.teacherId == request.auth.uid
      ) || (
        isStudent() && me().data.classId == classId
      );

      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;

      allow update, delete: if isOwner() || (
        isTeacher() && resource.data.teacherId == request.auth.uid
      );
    }

    match /attempts/{attemptId} {
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId == me().data.teacherId
        && request.resource.data.classId == me().data.classId;

      allow read: if signedIn() && (
        isOwner() ||
        (isStudent() && resource.data.studentId == request.auth.uid) ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );

      // When a teacher moves a class, only the classId may change.
      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["classId"]);

      allow delete: if isOwner() || (
        isTeacher() && resource.data.teacherId == request.auth.uid
      );
    }
  }
}
